skrip/distro-splash.script

Window.SetBackgroundTopColor(0.08, 0.10, 0.14);
Window.SetBackgroundBottomColor(0.05, 0.06, 0.09);

logo.image = Image("logo-distro.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(1);

Skrip grafis Plymouth untuk menggambar latar gradasi gelap dan menempatkan logo di tengah layar saat proses booting.
