skrip/setup-wallpaper.sh

#!/usr/bin/env bash
set -e

WALL_DIR="/usr/share/backgrounds/distro-custom"
WALL_FILE="${WALL_DIR}/Wallpaper-distro.jpeg"

mkdir -p "$WALL_DIR"
cd "$WALL_DIR"

# Hapus symlink rusak jika ada
if [ -L "Wallpaper-distro.jpg" ]; then
  rm -f "Wallpaper-distro.jpg"
fi

chmod 755 "$WALL_DIR"
chmod 644 "$WALL_DIR"/*

# Symlink fallback untuk XFCE
mkdir -p /usr/share/backgrounds/xfce
ln -sf "$WALL_FILE" /usr/share/backgrounds/xfce/xfce-verticals.png
ln -sf "$WALL_FILE" /usr/share/backgrounds/xfce/xfce-shapes.svg

# Konfigurasi XFCE default untuk user baru / Live
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
cp /root/tahap1/konfigurasi/xfce4-desktop.xml \
  /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml

# Konfigurasi LightDM greeter
cp /root/tahap1/konfigurasi/lightdm-gtk-greeter.conf \
  /etc/lightdm/lightdm-gtk-greeter.conf
chmod 644 /etc/lightdm/lightdm-gtk-greeter.conf

Menyiapkan folder wallpaper di /usr/share/backgrounds/distro-custom,
membersihkan symlink rusak jika ada, mengatur izin baca (644/755),
membuat symlink fallback XFCE, dan menyalin konfigurasi desktop/LightDM. 
(Pastikan Wallpaper-distro.jpeg sudah berada di folder tersebut sebelum menjalankan skrip).
